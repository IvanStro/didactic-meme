# StrIM Stage 3 — Redis + multi-VPS (скопіювати фрагменти в .env на відповідний хост)

# --- Control plane (business-117) ---
STRIM_NODE_ROLE=control
STRIM_CRON_HOST=business-117.default-host.net
STRIM_EXEC_ON_CONTROL=0

QUEUE_BACKEND=mysql
# mysql | redis | dual  (dual = push MySQL+Redis, pop MySQL — для міграції)

# ADM.TOOLS (unix socket у панелі Redis):
REDIS_SOCKET=/home/bot20/.system/redis.sock
# або: REDIS_URL=unix:///home/bot20/.system/redis.sock

REDIS_SIGNAL_SHARDS=16
REDIS_PRICE_BUS=1
QUEUE_BACKEND=mysql

ENGINE_MODE=v2

# --- Worker VPS #2 (shards 0–7) ---
# STRIM_NODE_ROLE=worker
# STRIM_EXEC_ON_CONTROL=0
# QUEUE_BACKEND=redis
# REDIS_URL=redis://10.0.0.1:6379
# WORKER_SHARD_IDS=0,1,2,3,4,5,6,7
# SIGNAL_EXEC_WORKERS=16
# DB_HOST=... (MySQL primary на control, remote)

# --- Worker VPS #3 (shards 8–15) ---
