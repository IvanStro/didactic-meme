# Deny-only for sensitive API scripts.
# Do NOT put API GATE RewriteRules here — gate lives in www/.htaccess only.
# A duplicate gate in this file breaks /api/* (rewrite to /api/auth/api_gate.php → 500 HTML).

<Files "debug_orders.php">
Order deny,allow
Deny from all
</Files>

